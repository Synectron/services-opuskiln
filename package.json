{
  "name": "rkn-punjabi-soya-chaap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cf": "wrangler pages dev --local --port 8788 --proxy 4327",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test src/lib/order.test.ts",
    "preview": "vite preview",
    "db:seed:generate": "node --experimental-strip-types scripts/generate-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply rkn-menu --local",
    "db:migrate:remote": "wrangler d1 migrations apply rkn-menu --remote",
    "cf:deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/hind": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.166.0"
  }
}
